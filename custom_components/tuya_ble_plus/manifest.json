{
  "domain": "tuya_ble_plus",
  "name": "Tuya BLE Plus",
  "version": "0.2.0",
  "documentation": "https://github.com/fragpic/tuya-ble-plus#readme",
  "issue_tracker": "https://github.com/fragpic/tuya-ble-plus/issues",
  "config_flow": true,
  "flow_title": "{name}",
  "is_built_in": false,
  "stage": "alpha",
  "homeassistant": "2024.4.0",
  "integration_type": "device",
  "configurable": true,
  "iot_class": "local_push",
  "dependencies": ["bluetooth_adapters"],
  "after_dependencies": ["bluetooth"],
  "supported_platforms": [
    "binary_sensor",
    "button",
    "climate",
    "cover",
    "number",
    "select",
    "sensor",
    "switch",
    "text"
  ],
  "requirements": ["pycountry>=22.3.5"],
  "codeowners": ["@PlusPlus-ua", "@fragpic"],
  "bluetooth": [
    {
      "connectable": true,
      "service_data_uuid": "0000a201-0000-1000-8000-00805f9b34fb"
    }
  ],
  "dhcp": [],
  "icon": "mdi:bluetooth-connect"
}
